{
  "data": {"url": "/media/notities/20140110/2014-01-07-prijsontwikkeling-duits-franse-veiling.csv"},
  "transform": [{"filter": {"field": "Boomsoort", "oneOf": ["Eik", "Es", "Gewone esdoorn", "Zoete kers"]}}],
  "encoding": {"x": {"field": "Jaar", "type": "temporal"}},
  "layer": [
    {
      "encoding": {
        "color": {"field": "Boomsoort", "type": "nominal"},
        "y": {"field": "Prijs", "type": "quantitative"}
      },
      "layer": [
        {"mark": "line"},
        {"transform": [{"filter": {"param": "hover", "empty": false}}], "mark": "point"}
      ]
    },
    {
      "transform": [{"pivot": "Boomsoort", "value": "Prijs", "groupby": ["Jaar"]}],
      "mark": "rule",
      "encoding": {
        "opacity": {
          "condition": {"value": 0.3, "param": "hover", "empty": false},
          "value": 0
        },
        "tooltip": [
          {"field": "Eik", "type": "quantitative"},
          {"field": "Es", "type": "quantitative"},
          {"field": "Gewone esdoorn", "type": "quantitative"},
          {"field": "Zoete kers", "type": "quantitative"}
        ]
      },
      "params": [{
        "name": "hover",
        "select": {
          "type": "point",
          "fields": ["Prijs"],
          "nearest": true,
          "on": "pointerover",
          "clear": "pointerout"
        }
      }]
    }
  ]
}
